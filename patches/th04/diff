@@ -0,0 +1,75 @@
+#include <string.h>
+#include "platform.h"
+#include "pc98.h"
+#include "th04/config/genscfg.hpp"
+#include "th04/common.h"
+#include "th04/playchar.h"
+#include "th04/resident.hpp"
+#include "libs/master.lib/master.hpp"
+
+#define CONFIG_FILENAME "GENSOO.CFG"
+// The guard of values are intentionally not written; they are kept in rust
+// due to the language understanding, PC-98 vs modern hardware build and
+// concept of "less code more documentation". Making them would be a mess
+// and without any explaination, that's not what we want.
+static int parse_dec(const char *p)
+{
+	int value = 0;
+	while((*p >= '0') && (*p <= '9')) {
+		value = ((value * 10) + (*p - '0'));
+		p++;
+	}
+	return value;
+}
+
+int gensoo_cfg_load_and_apply(void far *resident_ptr)
+{
+	resident_t far *resident = (resident_t far *)resident_ptr;
+	int fd = file_ropen(CONFIG_FILENAME);
+	if(!fd) {
+		return 0;
+	}
+
+	char conf_buf[512] = { 0 };
+	file_read(conf_buf, (sizeof(conf_buf) - 1));
+	file_close();
+
+	char *ptr;
+	if((ptr = strstr(conf_buf, "total_live=")) != 0) {
+		resident->cfg_lives = parse_dec(ptr + 11);
+	}
+	if((ptr = strstr(conf_buf, "total_bomb=")) != 0) {
+		resident->cfg_bombs = parse_dec(ptr + 11);
+	}
+	if((ptr = strstr(conf_buf, "skip_to=")) != 0) {
+		int stage = parse_dec(ptr + 8);
+		if(stage > STAGE_EXTRA) {
+			stage = STAGE_EXTRA;
+		}
+		resident->stage = stage;
+		resident->stage_ascii = ('0' + stage);
+	}
+	if((ptr = strstr(conf_buf, "char=")) != 0) {
+		int variant = parse_dec(ptr + 5);
+		const int variant_count = (PLAYCHAR_COUNT * SHOTTYPE_COUNT);
+		if(variant >= variant_count) {
+			variant = (variant_count - 1);
+		}
+		resident->playchar_ascii = ('0' + (variant / SHOTTYPE_COUNT));
+		resident->shottype = (variant % SHOTTYPE_COUNT);
+	}
+	if((ptr = strstr(conf_buf, "rank=")) != 0) {
+		resident->rank = parse_dec(ptr + 5);
+	}
+	if((ptr = strstr(conf_buf, "power=")) != 0) {
+		resident->cfg_power = parse_dec(ptr + 6);
+	}
+	if((ptr = strstr(conf_buf, "skip_to_boss_phase=")) != 0) {
+		resident->skip_to_boss_phase = parse_dec(ptr + 19);
+	}
+	if((ptr = strstr(conf_buf, "end_phase=")) != 0) {
+		resident->end_phase = parse_dec(ptr + 10);
+	}
+	resident->demo_num = 0;
+	return 1;
+}
