index 00000000..2b164526
--- /dev/null
+++ b/th04/main/boss/phsk.cpp
@@ -0,0 +1,271 @@
+#pragma option -zCmain_01_TEXT -zPmain_01
+
+#include "th04/resident.hpp"
+#include "th04/common.h"
+#include "th04/playchar.h"
+#include "th04/main/frames.h"
+#include "th04/main/boss/boss.hpp"
+#include "th04/main/bullet/bullet.hpp"
+#include "th04/main/bullet/clearzap.hpp"
+#include "th04/main/bullet/laser_t.hpp"
+#include "th04/formats/map.hpp"
+#include "th04/formats/std.hpp"
+#include "th04/main/scroll.hpp"
+#include "th04/main/tile/tile.hpp"
+#include "th04/main/dialog/dialog.hpp"
+
+extern "C" void pascal far enemies_update(void);
+extern unsigned char elly_phase;
+extern unsigned char marisa_phase;
+
+// The stage VM normally reaches the boss while scrolls. So we need the state
+// while avoiding spawning, then seeks the VM.
+static void near direct_entry_put_map_row(
+	int ring_row, int std_section, int map_row
+)
+{
+	const uint8_t section_id = std_seg[std_section];
+	for(int x = 0; x < TILES_X; x++) {
+		tile_ring[ring_row][x] = map_seg[section_id].row[map_row][x];
+	}
+}
+
+// We must discard only the instructions whicb are skipped part of the stage.
+// ST02.STD still has Elly attack at frames 7900 through 9200,
+// after scrolling has stopped and the dialog has run.
+static void near direct_entry_seek_stage_vm(unsigned int target_frame)
+{
+	uint8_t far *ip = reinterpret_cast<uint8_t far *>(std_ip);
+	while(*reinterpret_cast<unsigned int far *>(ip) != 0) {
+		const unsigned int instruction_frame = (
+			*reinterpret_cast<unsigned int far *>(ip)
+		);
+		if(instruction_frame >= target_frame) {
+			break;
+		}
+		ip += (3 + (ip[2] * 8));
+	}
+	std_ip = ip;
+}
+
+void near boss_direct_entry_prepare(void)
+{
+	if(!std_seg || !map_seg) {
+		return;
+	}
+
+	unsigned int speed_offset = reinterpret_cast<unsigned int>(std_scroll_speed);
+	const unsigned int speed_chunk_offset = (
+		speed_offset - (TILES_Y / TILE_ROWS_PER_SECTION)
+	);
+	unsigned int speed = std_seg[speed_chunk_offset];
+	unsigned int simulated_frames = 0;
+	unsigned int scroll_subpixel = 0;
+	int simulated_scroll_line = 0;
+	int previous_tile_line = 0;
+	int section = std_map_section_id;
+	int row_in_section = 0;
+
+	// This is the scrolling main loop, without rendering updates.
+	// Stage 3 reaches the dialog after 7_834 stage frames with two
+	// subpixels left over.
+	while((speed != 0) && (simulated_frames < 32767)) {
+		simulated_frames++;
+		scroll_subpixel += speed;
+		if(scroll_subpixel >= SUBPIXEL_FACTOR) {
+			const int pixels = (scroll_subpixel >> SUBPIXEL_BITS);
+			simulated_scroll_line -= pixels;
+			while(simulated_scroll_line < 0) {
+				simulated_scroll_line += RES_Y;
+			}
+			scroll_subpixel &= (SUBPIXEL_FACTOR - 1);
+		}
+
+		const int tile_line = (simulated_scroll_line / TILE_H);
+		if(tile_line != previous_tile_line) {
+			previous_tile_line = tile_line;
+			row_in_section--;
+			if(row_in_section < 0) {
+				row_in_section = (TILE_ROWS_PER_SECTION - 1);
+				section++;
+				speed_offset++;
+				speed = std_seg[speed_offset];
+				if(speed == 0) {
+					simulated_scroll_line = 0;
+					break;
+				}
+			}
+			direct_entry_put_map_row(tile_line, section, row_in_section);
+		}
+	}
+
+	std_map_section_id = section;
+	std_scroll_speed = reinterpret_cast<SubpixelLength8 near *>(speed_offset);
+	tile_row_in_section = row_in_section;
+	scroll_speed.v = 0;
+	scroll_subpixel_line.v = static_cast<uint8_t>(scroll_subpixel);
+	scroll_line = simulated_scroll_line;
+	scroll_line_on_page[0] = simulated_scroll_line;
+	scroll_line_on_page[1] = simulated_scroll_line;
+	stage_frame = simulated_frames;
+	stage_frame_mod2 = (stage_frame & 1);
+	stage_frame_mod4 = (stage_frame & 3);
+	stage_frame_mod8 = (stage_frame & 7);
+	stage_frame_mod16 = (stage_frame & 15);
+	direct_entry_seek_stage_vm(stage_frame);
+	tiles_invalidate_all();
+}
+
+static void near boss_phase_skip_update(int forced_hp)
+{
+	unsigned int slot;
+
+	stage_vm();
+	enemies_update();
+	if(forced_hp >= 0) {
+		boss.hp = forced_hp;
+	}
+	boss_update_func();
+
+	for(slot = 0; slot < BULLET_COUNT; slot++) {
+		bullets[slot].flag = F_FREE;
+	}
+	bullet_clear_time = 0;
+	for(slot = 0; slot < THICKLASER_COUNT; slot++) {
+		thicklasers[slot].flag = TF_FREE;
+	}
+
+	stage_frame++;
+	stage_frame_mod16 = (stage_frame & 15);
+	stage_frame_mod8 = (stage_frame & 7);
+	stage_frame_mod4 = (stage_frame & 3);
+	stage_frame_mod2 = (stage_frame & 1);
+}
+
+void pascal far boss_phase_skip_apply(void)
+{
+	int8_t skip_phase = resident->skip_to_boss_phase;
+	unsigned char target_phase;
+	unsigned char elly_target_phase = 0;
+	unsigned char marisa_target_phase = 0;
+	// Differs from th05. The work of th05 will be done later
+	// and they will be in one repo.
+	if(skip_phase <= 0) {
+		return;
+	}
+	if(resident->stage == 2) {
+		// Elly Floor Attack is phase 1. After the frame hard coded state
+		// transition we track them with number trick.
+		if(skip_phase == 1) {
+			target_phase = 1;
+		} else {
+			target_phase = 3;
+			elly_target_phase = (skip_phase - 2);
+		}
+	} else if((resident->stage == 3) && (playchar == PLAYCHAR_REIMU)) {
+		target_phase = 2;
+		marisa_target_phase = (skip_phase - 1);
+	} else if(resident->stage == STAGE_EXTRA) {
+		enum {
+			MUGETSU_PHASE_COUNT = 2,
+		};
+		if(skip_phase > MUGETSU_PHASE_COUNT) {
+			// Run the original second dialog.
+			dialog_animate();
+			gengetsu_start();
+
+			if(skip_phase <= 6) {
+				target_phase = (skip_phase - 1);
+			} else {
+				target_phase = skip_phase;
+			}
+		} else {
+			// Phases 1..2 are Mugetu raw attack states 2 and 4
+			target_phase = (skip_phase * 2);
+		}
+	} else {
+		static const unsigned char stage0_phases[] = { 2, 3, 4 };
+		static const unsigned char stage1_phases[] = { 2, 3, 4, 5 };
+		// Here we got 100% is the marisa vs remu boss
+		static const unsigned char stage3_phases[] = {
+			2, 3, 5, 7, 9, 10, 11,
+		};
+		static const unsigned char stage4_phases[] = {
+			2, 6, 9, 13, 17,
+		};
+		static const unsigned char stage5_phases[] = {
+			2, 3, 4, 6, 10, 11, 14,
+		};
+		switch(resident->stage) {
+		case 0:
+			target_phase = stage0_phases[skip_phase - 1];
+			break;
+		case 1:
+			target_phase = stage1_phases[skip_phase - 1];
+			break;
+		case 3:
+			target_phase = stage3_phases[skip_phase - 1];
+			break;
+		case 4:
+			target_phase = stage4_phases[skip_phase - 1];
+			break;
+		case 5:
+			target_phase = stage5_phases[skip_phase - 1];
+			break;
+		}
+	}
+
+	while(boss.phase < target_phase) {
+		// Claudio's task here. Today, the task for readers is finally completed as side quest.
+		//
+		// [copy]
+		//      
+		// â€¦ yeah, no, we won't get very far without figuring out these drawing routines.
+        // Which process data that comes from the .STD files. Which has various arrays 
+		// related to the backgroundâ€¦ including one to specify the scrolling speed. 
+		// And wait, setting that to 0 actually is what starts a boss battle?
+
+		// So, have a TH05 Boss Rush patch:
+		// 2018-12-26-TH05BossRush.zip
+		// Theoretically, this should have also worked for TH04, but for some reason, 
+		// the Stage 3 boss gets stuck on the first phase if we do this?
+        // Here's the diff for the Boss Rush. Turning it into a thcrap-style Skipgame 
+		// patch is left as an exercise for the reader.
+		// 
+		// We not only skip stages but also phases. And also, you forgot to mention that
+		// TH04's extra stage's issue.
+		// Solve to stage 3 special here below:
+
+		// ST02.STD spawns her floor panels as enemy obj, animate patterns 128 to 133,
+		// aimed at the player and continue across frame 9240.
+		bool phase_is_attack = (boss.phase > PHASE_BOSS_ENTRANCE_BB);
+		if(resident->stage == STAGE_EXTRA) {
+			if(boss_statebyte[0]) {
+				phase_is_attack = (
+					((boss.phase >= 2) && (boss.phase <= 5)) ||
+					(boss.phase == 7) || (boss.phase == 8)
+				);
+			} else {
+				phase_is_attack = ((boss.phase == 2) || (boss.phase == 4));
+			}
+		}
+		boss_phase_skip_update(
+			phase_is_attack ? boss.phase_end_hp : -1
+		);
+	}
+
+	if(resident->stage == 2) {
+		static const int ELLY_PHASE_END_HP[] = {
+			4700, 3300, 2100, 700,
+		};
+		while(elly_phase < elly_target_phase) {
+			boss_phase_skip_update(ELLY_PHASE_END_HP[elly_phase]);
+		}
+	}
+	if((resident->stage == 3) && (playchar == PLAYCHAR_REIMU)) {
+		static const int MARISA_PHASE_END_HP[] = { 4500, 2500, 1000 };
+		while(marisa_phase < marisa_target_phase) {
+			boss_phase_skip_update(MARISA_PHASE_END_HP[marisa_phase]);
+		}
+	}
+}
