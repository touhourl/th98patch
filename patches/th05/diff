+		boss_update_func();
+		for(slot = 0; slot < BULLET_COUNT; slot++) {
+			bullets[slot].flag = F_FREE;
+		}
+		bullet_clear_time = 0;
+		for(slot = 0; slot < LASER_COUNT; slot++) {
+			lasers[slot].flag = LF_FREE;
