diff --git a/th05/config/kaikcfg.cpp b/th05/config/kaikcfg.cpp
new file mode 100644
index 00000000..d78335db
--- /dev/null
+++ b/th05/config/kaikcfg.cpp
@@ -0,0 +1,77 @@
+#include <string.h>
+#include "platform.h"
+#include "pc98.h"
+#include "th05/config/kaikcfg.hpp"
+#include "th05/resident.hpp"
+#include "libs/master.lib/master.hpp"
+
+#define CONFIG_FILENAME "KAIKII.CFG"
+
+static int parse_dec(const char* p)
+{
+	int value = 0;
+	while((*p >= '0') && (*p <= '9')) {
+		value = (value * 10) + (*p - '0');
+		p++;
+	}
+	return value;
+}
+
+int kaikii_cfg_load_and_apply(void far *resident_ptr)
+{
+	resident_t far *resident = (resident_t far *)resident_ptr;
+	int fd = file_ropen(CONFIG_FILENAME);
+	if (!fd) {
+		return 0;
+	}
+	char conf_buf[512] = {0};
+	file_read(conf_buf, sizeof(conf_buf)-1);
+	file_close();
+	char* ptr;
+	
+	if((ptr = strstr(conf_buf, "total_live="))) {
+		resident->cfg_lives = parse_dec(ptr + 11);
+	}
+	
+	if((ptr = strstr(conf_buf, "total_bomb="))) {
+		resident->cfg_bombs = parse_dec(ptr + 11);
+	}
+	
+	if((ptr = strstr(conf_buf, "skip_to="))) {
+		resident->stage = parse_dec(ptr + 8);
+	}
+	
+	if((ptr = strstr(conf_buf, "char="))) {
+		resident->playchar = parse_dec(ptr + 5);
+	}
+	
+	if((ptr = strstr(conf_buf, "rank="))) {
+		resident->rank = parse_dec(ptr + 5);
+	}
+	
+	if((ptr = strstr(conf_buf, "power="))) {
+		resident->cfg_power = parse_dec(ptr + 6);
+	}
+	
+	if((ptr = strstr(conf_buf, "skip_to_boss_phase="))) {
+		resident->skip_to_boss_phase = parse_dec(ptr + 19);
+	}
+
+	if((ptr = strstr(conf_buf, "end_phase="))) {
+		resident->end_phase = parse_dec(ptr + 10);
+	}
+
+	if(resident->skip_to_boss_phase < 0) {
+		resident->skip_to_boss_phase = 0;
+	}
+	if((resident->end_phase != 0) && (resident->end_phase <= resident->skip_to_boss_phase)) {
+		resident->end_phase = resident->skip_to_boss_phase + 1;
+		if(resident->end_phase > 12) {
+			resident->end_phase = 12;
+		}
+	}
+	resident->demo_num = 0;
+	
+	return 1;
+}
+
